# Copy to ~/.ghosted/.env and chmod 600. Secrets only. Never commit the real file.
# Remote adapter (Cloudflare Access service token for POST /api/sync):
GHOSTED_SERVICE_TOKEN_ID=
GHOSTED_SERVICE_TOKEN_SECRET=
# Pushover adapter (optional):
PUSHOVER_TOKEN=
PUSHOVER_USER=
# Self-hosted ntfy with auth (optional; ntfy.sh needs nothing):
NTFY_TOKEN=
